<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant_sc"
            android:letterSpacing="0.3"
            android:textColor="@color/brass"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:background="@color/brass_dim" />

        <TextView
            android:id="@+id/quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cormorant_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/ivory"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/cormorant_italic"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/stone"
            android:textSize="19sp" />

        <Button
            android:id="@+id/add_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/button_bg"
            android:fontFamily="@font/cormorant_sc"
            android:letterSpacing="0.15"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/add_widget"
            android:textAllCaps="false"
            android:textColor="@color/brass"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/cormorant_italic"
            android:gravity="center"
            android:text="@string/hint"
            android:textColor="@color/stone_dim"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
