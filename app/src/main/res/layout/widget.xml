<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cormorant_sc"
        android:letterSpacing="0.3"
        android:maxLines="1"
        android:text="FRAGMENT 10"
        android:textColor="@color/brass"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="8dp"
        android:background="@color/brass_dim" />

    <TextView
        android:id="@+id/quote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/cormorant_medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:text="Nature loves to hide."
        android:textColor="@color/ivory" />

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/cormorant_italic"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:textColor="@color/stone"
        android:visibility="gone" />
</LinearLayout>
